{
    "bin": {"author_runner": "jdeploy-bundle/jdeploy.js"},
    "author": "Wim van Velthoven",
    "main": "index.js",
    "preferGlobal": true,
    "repository": {"url": "https://github.com/wimvvelt/numworx-author"},
    "version": "1.0.4",
    "jdeploy": {
        "args": ["-Xmx2G"],
        "fallbackToUniversal": false,
        "publishTargets": [{
